# Tudo opcional: sem nada aqui o app roda em modo demonstração, 100% local e gratuito.

# Banco: sem estas duas, usa data/db.json
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Instagram real (crie um app em developers.facebook.com, produto "Login do Facebook")
META_APP_ID=
META_APP_SECRET=
# Chave para criptografar o token do Instagram (qualquer texto longo e aleatório)
RV_SECRET=

# IA gratuita (opcional): chave do plano gratuito em aistudio.google.com, SEM ativar cobrança no projeto.
# O plano gratuito tem limite diário e o Google pode usar o texto enviado: não inclua dados de clientes.
GEMINI_API_KEY=
GEMINI_MODEL=

# IA paga por uso. Fica desligada mesmo com chave no ambiente, a menos que RV_ALLOW_PAID_AI=1.
RV_ALLOW_PAID_AI=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# 1 = publica o agendado e coleta os números enquanto o app estiver aberto (o atalho local já liga)
RV_SCHEDULER=

# Coleta diária (/api/cron/sync). Sem ele a rota recusa todas as chamadas.
CRON_SECRET=

# Endereço público do app, usado no retorno do login da Meta
APP_URL=

# Demonstração e cadastro. Em produção a demo fica desligada e só o primeiro cadastro é aceito.
RV_DEMO=
RV_ALLOW_SIGNUP=

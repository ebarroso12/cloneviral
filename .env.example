# Tudo opcional: sem nada aqui o app roda em modo demonstração, 100% local e gratuito.

# Banco: sem estas duas, usa data/db.json
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Instagram real (crie um app em developers.facebook.com, produto "Login do Facebook")
META_APP_ID=
META_APP_SECRET=
# Chave para criptografar o token do Instagram (qualquer texto longo e aleatório)
RV_SECRET=

# IA de verdade (opcional). Sem isto os textos saem de modelos próprios do app.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Coleta diária (/api/cron/sync). Sem ele a rota recusa todas as chamadas.
CRON_SECRET=

# Endereço público do app, usado no retorno do login da Meta
APP_URL=

# Demonstração e cadastro. Em produção a demo fica desligada e só o primeiro cadastro é aceito.
RV_DEMO=
RV_ALLOW_SIGNUP=
